{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@earendil-works/pi-coding-agent": ["./src/pi-sdk.d.ts"],
      "@earendil-works/pi-tui": ["./src/pi-tui.d.ts"]
    }
  },
  "include": ["src"]
}
