{
  "name": "@lerg96/pi-auto-mode",
  "version": "0.1.0",
  "description": "Permission gate and selective LLM/Jev risk classifier extension for Pi coding agent.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "permissions",
    "security",
    "classifier",
    "jev"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lerg96/pi-auto-mode.git"
  },
  "homepage": "https://github.com/lerg96/pi-auto-mode#readme",
  "bugs": {
    "url": "https://github.com/lerg96/pi-auto-mode/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.ts",
    "src",
    "config.example.json",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "build": "tsc -p tsconfig.json",
    "prepare": "husky",
    "dataset:export": "node --experimental-strip-types src/telemetry/dataset-exporter.ts"
  },
  "dependencies": {
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8",
    "zod": "^3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "husky": "^9.1.7",
    "jest": "^30.5.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "npm test -- --passWithNoTests"
    ],
    "*.{js,json,md}": [
      "prettier --write"
    ]
  }
}
